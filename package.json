{
  "name": "splav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Splav (Merge River): merge puzzle on a flowing river for Yandex Games",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:yg": "npm run build && npx @yandex-games/sdk-dev-proxy -p dist --dev-mode=true",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --coverage",
    "test:levels": "vitest run tests/levels",
    "e2e": "playwright test",
    "e2e:install": "tsx scripts/e2e-install.ts",
    "zip": "tsx scripts/zip.ts",
    "check:build": "tsx scripts/check-build.ts",
    "verify": "tsx scripts/verify.ts",
    "sim": "tsx scripts/sim-cli.ts",
    "bench": "tsx scripts/bench.ts",
    "balance": "tsx scripts/balance.ts",
    "art": "tsx scripts/stub.ts art 5",
    "promo": "tsx scripts/stub.ts promo 5"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "@yandex-games/sdk-dev-proxy": "0.0.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
